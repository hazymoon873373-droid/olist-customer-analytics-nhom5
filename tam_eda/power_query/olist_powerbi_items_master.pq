let Source = Csv.Document(File.Contents(DataRoot & "/olist_powerbi_items_master.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Normalized = Table.TransformColumnNames(Headers, each if _ = "" then "Column1" else _), Typed = Table.TransformColumnTypes(Normalized, {{"order_id", type text},{"order_item_id", Int64.Type},{"product_id", type text},{"seller_id", type text},{"shipping_limit_date", type datetime},{"price", type number},{"freight_value", type number},{"order_status", type text},{"order_purchase_timestamp", type datetime},{"category_english", type text},{"product_weight_g", Int64.Type}}, "en-US") in Typed