let Source = Csv.Document(File.Contents(DataRoot & "/classification_report.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Normalized = Table.TransformColumnNames(Headers, each if _ = "" then "Column1" else _), Typed = Table.TransformColumnTypes(Normalized, {{"Column1", type text},{"precision", type number},{"recall", type number},{"f1-score", type number},{"support", type number}}, "en-US") in Typed