let Source = Csv.Document(File.Contents(DataRoot & "/olist_powerbi_orders_master.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Normalized = Table.TransformColumnNames(Headers, each if _ = "" then "Column1" else _), Typed = Table.TransformColumnTypes(Normalized, {{"order_id", type text},{"customer_id", type text},{"order_status", type text},{"order_purchase_timestamp", type datetime},{"order_approved_at", type datetime},{"order_delivered_carrier_date", type datetime},{"order_delivered_customer_date", type datetime},{"order_estimated_delivery_date", type datetime},{"customer_unique_id", type text},{"customer_zip_code_prefix", type text},{"customer_city", type text},{"customer_state", type text},{"state_name", type text},{"region_name", type text},{"main_payment_type", type text},{"max_installments", type number},{"review_score", type number},{"total_products_value", type number},{"total_freight_value", type number},{"total_items", Int64.Type},{"segment", type text},{"delivery_days", type number},{"delay_days", type number},{"is_delayed", type logical},{"order_year_month", type datetime},{"valid_delay_kpi", type logical},{"delivered_missing_date", type logical},{"carrier_before_approval", type logical},{"customer_before_carrier", type logical}}, "en-US") in Typed