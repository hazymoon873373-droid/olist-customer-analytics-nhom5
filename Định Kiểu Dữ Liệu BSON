db.olist_orders_clean.aggregate([
  {
    $addFields: {
      order_purchase_timestamp: { $cond: [{ $in: ["$order_purchase_timestamp", ["", "null", null]] }, null, { $toDate: "$order_purchase_timestamp" }] },
      order_approved_at: { $cond: [{ $in: ["$order_approved_at", ["", "null", null]] }, null, { $toDate: "$order_approved_at" }] },
      order_delivered_carrier_date: { $cond: [{ $in: ["$order_delivered_carrier_date", ["", "null", null]] }, null, { $toDate: "$order_delivered_carrier_date" }] },
      order_delivered_customer_date: { $cond: [{ $in: ["$order_delivered_customer_date", ["", "null", null]] }, null, { $toDate: "$order_delivered_customer_date" }] },
      order_estimated_delivery_date: { $cond: [{ $in: ["$order_estimated_delivery_date", ["", "null", null]] }, null, { $toDate: "$order_estimated_delivery_date" }] },
      delivered_missing_date: { $eq: [{ $toLower: { $toString: "$delivered_missing_date" } }, "true"] },
      carrier_before_approval: { $eq: [{ $toLower: { $toString: "$carrier_before_approval" } }, "true"] },
      customer_before_carrier: { $eq: [{ $toLower: { $toString: "$customer_before_carrier" } }, "true"] },
      valid_delay_kpi: { $eq: [{ $toLower: { $toString: "$valid_delay_kpi" } }, "true"] }
    }
  },
  { $merge: { into: "olist_orders_clean", on: "_id", whenMatched: "replace" } }
]);

