let Source = Csv.Document(File.Contents(DataRoot & "/churn_test_predictions_temporal_v4.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Normalized = Table.TransformColumnNames(Headers, each if _ = "" then "Column1" else _), Typed = Table.TransformColumnTypes(Normalized, {{"customer_unique_id", type text},{"split", type text},{"cutoff_timestamp", type datetime},{"prediction_window_end", type datetime},{"churn_proxy_180d", Int64.Type},{"churn_probability", type number},{"predicted_churn", Int64.Type},{"score_decile", Int64.Type},{"repurchased_true", Int64.Type},{"repurchase_probability", type number},{"prediction_threshold", type number},{"model_name", type text},{"model_version", type text}}, "en-US") in Typed