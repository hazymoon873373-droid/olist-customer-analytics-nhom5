let Source = Csv.Document(File.Contents(DataRoot & "/cohort_retention_matrix.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Normalized = Table.TransformColumnNames(Headers, each if _ = "" then "Column1" else _), Renamed = Table.RenameColumns(Normalized, {{"0", "Tháng bắt đầu cohort"},{ "1", "Tháng 1" },{ "2", "Tháng 2" },{ "3", "Tháng 3" },{ "4", "Tháng 4" },{ "5", "Tháng 5" },{ "6", "Tháng 6" },{ "7", "Tháng 7" },{ "8", "Tháng 8" },{ "9", "Tháng 9" },{ "10", "Tháng 10" },{ "11", "Tháng 11" },{ "12", "Tháng 12" },{ "13", "Tháng 13" },{ "14", "Tháng 14" },{ "15", "Tháng 15" },{ "16", "Tháng 16" },{ "17", "Tháng 17" },{ "18", "Tháng 18" },{ "19", "Tháng 19" },{ "20", "Tháng 20" },{ "21", "Tháng 21" },{ "22", "Tháng 22" },{ "23", "Tháng 23" }}, MissingField.Ignore), Typed = Table.TransformColumnTypes(Renamed, {{"CohortMonth", type text},{"Tháng bắt đầu cohort", type number},{"Tháng 1", type number},{"Tháng 2", type number},{"Tháng 3", type number},{"Tháng 4", type number},{"Tháng 5", type number},{"Tháng 6", type number},{"Tháng 7", type number},{"Tháng 8", type number},{"Tháng 9", type number},{"Tháng 10", type number},{"Tháng 11", type number},{"Tháng 12", type number},{"Tháng 13", type number},{"Tháng 14", type number},{"Tháng 15", type number},{"Tháng 16", type number},{"Tháng 17", type number},{"Tháng 18", type number},{"Tháng 19", type number},{"Tháng 20", type number},{"Tháng 21", type number},{"Tháng 22", type number},{"Tháng 23", type number}}, "en-US") in Typed