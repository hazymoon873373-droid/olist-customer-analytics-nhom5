let Source = Csv.Document(File.Contents(DataRoot & "/rfm_table.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Normalized = Table.TransformColumnNames(Headers, each if _ = "" then "Column1" else _), Typed = Table.TransformColumnTypes(Normalized, {{"customer_unique_id", type text},{"recency", Int64.Type},{"frequency", Int64.Type},{"monetary", type number},{"first_order", type datetime},{"last_order", type datetime},{"r_score", Int64.Type},{"f_score", Int64.Type},{"m_score", Int64.Type},{"rfm_segment_code", Int64.Type},{"segment", type text}}, "en-US") in Typed