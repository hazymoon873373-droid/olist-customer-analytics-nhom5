let Source = Csv.Document(File.Contents(DataRoot & "/rfm_segment_summary.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Normalized = Table.TransformColumnNames(Headers, each if _ = "" then "Column1" else _), Typed = Table.TransformColumnTypes(Normalized, {{"segment", type text},{"customer_count", Int64.Type},{"total_revenue", type number},{"avg_revenue", type number},{"avg_recency_days", type number},{"avg_frequency", type number},{"customer_pct", type number},{"revenue_pct", type number}}, "en-US") in Typed