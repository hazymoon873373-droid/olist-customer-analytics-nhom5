let Source = Csv.Document(File.Contents(DataRoot & "/probability_summary.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Normalized = Table.TransformColumnNames(Headers, each if _ = "" then "Column1" else _), Typed = Table.TransformColumnTypes(Normalized, {{"split", type text},{"model", type text},{"actual_class", type text},{"count", Int64.Type},{"threshold", type number},{"min", type number},{"q25", type number},{"median", type number},{"q75", type number},{"max", type number},{"predicted_return", Int64.Type},{"predicted_no_repurchase", Int64.Type}}, "en-US") in Typed