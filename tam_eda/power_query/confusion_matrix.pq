let Source = Csv.Document(File.Contents(DataRoot & "/confusion_matrix.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Normalized = Table.TransformColumnNames(Headers, each if _ = "" then "Column1" else _), Typed = Table.TransformColumnTypes(Normalized, {{"Column1", type text},{"predicted_return_0", Int64.Type},{"predicted_no_repurchase_1", Int64.Type}}, "en-US") in Typed