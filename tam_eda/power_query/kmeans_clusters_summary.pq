let Source = Csv.Document(File.Contents(DataRoot & "/kmeans_clusters_summary.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Normalized = Table.TransformColumnNames(Headers, each if _ = "" then "Column1" else _), Typed = Table.TransformColumnTypes(Normalized, {{"Cụm (Cluster)", type text},{"Phân cụ K-Means (ML Segment)", type text},{"Số lượng khách (Count)", Int64.Type},{"Tỷ trọng khách (%)", type number},{"Chi tiêu TB (Monetary R$)", type number},{"Số ngày chưa mua TB (Recency)", type number},{"Số đơn TB (Frequency)", type number}}, "en-US") in Typed