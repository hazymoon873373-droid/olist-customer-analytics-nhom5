var targetColls = [
  "olist_customers_clean", "olist_orders_clean", "olist_order_items_clean", 
  "olist_order_payments_clean", "olist_order_reviews_clean", "olist_products_clean", 
  "olist_sellers_clean", "olist_geolocation_clean", "product_category_name_translation_clean", 
  "geo_by_zip"
];

targetColls.forEach(function(collName) {
  if (db.getCollectionNames().includes(collName)) {
    var coll = db.getCollection(collName);
    var count = coll.countDocuments();
    var sample = coll.findOne();
    var idxs = coll.getIndexes().map(i => i.name).join(", ");

    print("\n Collection: " + collName);
    print("  - Số lượng Document : " + count);
    print("  - Danh sách Indexes : [" + idxs + "]");
    if (sample) {
      print("  - Kiểu dữ liệu mẫu (Sample Data Types) :");
      Object.keys(sample).forEach(function(key) {
        if (key !== "_id") {
          var val = sample[key];
          var typeName = (val instanceof Date) ? "ISODate" : typeof val;
          print("      * " + key.padEnd(30) + ": " + typeName);
        }
      });
    }
  }
});

